# ---- Database (Neon Postgres in staging/prod; local Postgres in dev) ----
DATABASE_URL=postgres://postgres@localhost:5432/aporia_dev

# ---- LLM (Anthropic API). Leave unset to run with the mock provider. ----
ANTHROPIC_API_KEY=
LLM_PROVIDER=mock            # mock | anthropic | bedrock
# AWS Bedrock (only when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1

# ---- Test mode: zero delivery delays ----
APORIA_TEST_MODE=1

# ---- Auth (WorkOS AuthKit). Unset => dev magic links printed to the server log. ----
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
AUTH_SECRET=change-me-in-production   # production: >= 32 chars (openssl rand -base64 48); the web app refuses to start without it
APP_URL=http://localhost:3000

# ---- Transactional email (Postmark). Unset => links printed to the server log. ----
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=no-reply@example.com

# ---- Observability (optional; each turns on when its keys are set) ----
APORIA_ENV=development       # environment tag in Sentry and Langfuse (e.g. staging)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
SENTRY_DSN=                  # worker errors/alerts and web server errors

# ---- Deploy (worker only) ----
# RUN_MIGRATIONS_ON_START=1   # apply migrations when the worker boots
# WORKER_CONCURRENCY=4

# ---- Notion import (optional; only for the scenario import script) ----
NOTION_TOKEN=
