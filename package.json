{
  "name": "aporia",
  "private": true,
  "version": "0.1.0",
  "description": "Simulation 01 (Venture Debt): an inbox-based deal simulation for junior transactional associates.",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "scenario:validate": "pnpm --filter @aporia/scenario run validate",
    "scenario:build-docs": "pnpm --filter @aporia/scenario run build-docs",
    "scenario:import": "pnpm --filter @aporia/scenario run import",
    "db:migrate": "pnpm --filter @aporia/db run migrate",
    "db:seed": "pnpm --filter @aporia/db run seed",
    "playthrough": "pnpm --filter @aporia/evals run playthrough",
    "evals:fast": "pnpm --filter @aporia/evals run fast",
    "evals:nightly": "pnpm --filter @aporia/evals run nightly",
    "dev:web": "pnpm --filter @aporia/web run dev",
    "dev:worker": "pnpm --filter @aporia/worker run dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
