{
  "name": "@rematter/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "playthrough": "tsx src/cli/playthrough.ts",
    "fast": "tsx src/cli/run-suite.ts --paths mixed --runs 3",
    "nightly": "tsx src/cli/run-suite.ts --paths strong,weak,mixed,answer-seeker,off-script --runs 4 --judge"
  },
  "dependencies": {
    "@rematter/db": "workspace:*",
    "@rematter/engine": "workspace:*",
    "@rematter/prompts": "workspace:*",
    "@rematter/scenario": "workspace:*",
    "@rematter/worker": "workspace:*",
    "yaml": "^2.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {}
}
